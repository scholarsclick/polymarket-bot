# ---------------------------------------------------------------------------
# Polymarket bot secrets. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Private key of the wallet that controls your Polymarket account.
# For an email/Magic (signature_type=1) or browser-wallet-proxy (signature_type=2)
# account this is the key of the *signing* EOA, and you must also set `funder`
# in config.yaml to your Polymarket proxy address (the one that holds USDC).
POLYMARKET_PRIVATE_KEY=

# Optional: L2 API credentials. If left blank the bot derives them at startup
# from the private key (no funds move — it's just an API signature).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
